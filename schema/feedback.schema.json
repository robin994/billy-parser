{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Billy parser feedback v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parser_id",
    "version",
    "result",
    "installation_fingerprint",
    "billy_version",
    "source_commit"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "parser_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$",
      "maxLength": 120
    },
    "version": { "type": "integer", "minimum": 1 },
    "result": {
      "type": "string",
      "enum": ["working", "partial", "failed"]
    },
    "installation_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "billy_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "source_commit": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
